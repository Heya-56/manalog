{
  "name": "manalog-mcp",
  "version": "0.1.0",
  "description": "ManaLog — a voice-first import/export sourcing agent for Alexa+ (self-hosted MCP server on AWS Lambda + Amazon Bedrock). Built for island economies, useful to any small importer.",
